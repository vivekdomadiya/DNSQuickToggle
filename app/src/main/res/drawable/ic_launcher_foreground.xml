<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield Fill (Semi-transparent Dark Navy) -->
    <path
        android:pathData="M54,24 L78,32 C78,56 54,76 54,82 C54,76 30,56 30,32 Z"
        android:fillColor="#800D1B2A" />

    <!-- Shield Border Outline -->
    <path
        android:pathData="M54,24 L78,32 C78,56 54,76 54,82 C54,76 30,56 30,32 Z"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="24"
                android:endX="78"
                android:endY="82"
                android:startColor="#00E5FF"
                android:endColor="#0091EA" />
        </aapt:attr>
    </path>

    <!-- DNS Connecting Circuit Lines -->
    <path
        android:pathData="M54,40 L42,65 M54,40 L66,65"
        android:strokeWidth="2.5"
        android:strokeColor="#6600E5FF"
        android:strokeLineCap="round" />

    <!-- Bottom connection line between client nodes -->
    <path
        android:pathData="M42,65 L66,65"
        android:strokeWidth="2"
        android:strokeColor="#3300E5FF"
        android:strokeLineCap="round" />

    <!-- Top DNS Server Node (Circle + Dot) -->
    <path
        android:pathData="M54,37m-4.5,0a4.5,4.5 0 1,1 9,0a4.5,4.5 0 1,1 -9,0"
        android:fillColor="#00E5FF" />
    <path
        android:pathData="M54,37m-2,0a2,2 0 1,1 4,0a2,2 0 1,1 -4,0"
        android:fillColor="#FFFFFF" />

    <!-- Left Network Node -->
    <path
        android:pathData="M42,65m-3.5,0a3.5,3.5 0 1,1 7,0a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#00B0FF" />
    <path
        android:pathData="M42,65m-1.5,0a1.5,1.5 0 1,1 3,0a1.5,1.5 0 1,1 -3,0"
        android:fillColor="#FFFFFF" />

    <!-- Right Network Node -->
    <path
        android:pathData="M66,65m-3.5,0a3.5,3.5 0 1,1 7,0a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#00B0FF" />
    <path
        android:pathData="M66,65m-1.5,0a1.5,1.5 0 1,1 3,0a1.5,1.5 0 1,1 -3,0"
        android:fillColor="#FFFFFF" />

    <!-- Center Quick Toggle Switch Track -->
    <path
        android:pathData="M42,47 h24 c3.3,0 6,2.7 6,6 c0,3.3 -2.7,6 -6,6 h-24 c-3.3,0 -6,-2.7 -6,-6 c0,-3.3 2.7,-6 6,-6 Z"
        android:fillColor="#CC0F2027"
        android:strokeWidth="1.5"
        android:strokeColor="#00E5FF" />

    <!-- Quick Toggle Thumb / Switch (Active Right Position with Glow) -->
    <path
        android:pathData="M64,53m-4.5,0a4.5,4.5 0 1,1 9,0a4.5,4.5 0 1,1 -9,0"
        android:fillColor="#00E5FF" />
    <path
        android:pathData="M64,53m-2.5,0a2.5,2.5 0 1,1 5,0a2.5,2.5 0 1,1 -5,0"
        android:fillColor="#FFFFFF" />

    <!-- Small Power / Toggle Status Tick on Thumb -->
    <path
        android:pathData="M43,53 h4"
        android:strokeWidth="1.5"
        android:strokeColor="#6600E5FF"
        android:strokeLineCap="round" />

</vector>
